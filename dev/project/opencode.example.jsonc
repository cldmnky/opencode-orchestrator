{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    {
      "package": "__PLUGIN_ENTRY__",
      "options": {
        "orchestrator": "orchestrator",
        "roles": {
          "planning": "planner",
          "research": "explore",
          "implementation": "implementer",
          "review": "reviewer"
        },
        "max_parallel": 4,
        "strict_agents": true,
        "github": {
          "enabled": false,
          "allow_mutations": false
        },
        "worktree": {
          "enabled": false,
          "allow_mutations": false,
          "root": null
        },
        // S3/V1 controls — all opt-in, defaults preserve the previous behavior.
        // trace: off | memory | snapshot (bounded metadata summaries only)
        "trace": { "mode": "off" },
        // budget: advisory | stop-between-steps with nullable strict limits
        "budget": {
          "mode": "advisory",
          "max_steps": null,
          "max_tokens": null,
          "max_cost_usd": null,
          "max_wall_clock_ms": null,
          "max_retries": null
        },
        // review: prompt | bounded (max_rounds 1..8, rounds remaining must
        // absorb rework before the terminal circuit breaker opens)
        "review": { "mode": "prompt", "max_rounds": 2 },
        // clarify: auto | off (auto = the orchestrator uses the native ask
        // tool for targeted clarifying questions before decomposing an
        // ambiguous task; off = previous behavior)
        "clarify": { "mode": "auto" }
      }
    }
  ],
  "agents": {
    "orchestrator": {
      "mode": "primary",
      "model": "opencode/big-pickle"
    },
    "planner": {
      "mode": "subagent",
      "model": "opencode/big-pickle"
    },
    "explore": {
      "mode": "subagent",
      "model": "opencode/big-pickle"
    },
    "implementer": {
      "mode": "subagent",
      "model": "opencode/big-pickle"
    },
    "reviewer": {
      "mode": "subagent",
      "model": "opencode/big-pickle"
    }
  }
}
