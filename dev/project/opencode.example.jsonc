{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    {
      "package": "__PLUGIN_ENTRY__",
      "options": {
        "orchestrator": "orchestrator",
        "roles": {
          "planning": "planner",
          "research": "explore",
          "implementation": "implementer",
          "review": "reviewer"
        },
        "max_parallel": 4,
        "strict_agents": true,
        "github": {
          "enabled": false,
          "allow_mutations": false
        },
        "worktree": {
          "enabled": false,
          "allow_mutations": false,
          "root": null
        },
        // S3/V1 controls — all opt-in, defaults preserve the previous behavior.
        // trace: off | memory | snapshot (bounded metadata summaries only)
        "trace": { "mode": "off" },
        // budget: advisory | stop-between-steps with nullable strict limits
        "budget": {
          "mode": "advisory",
          "max_steps": null,
          "max_tokens": null,
          "max_cost_usd": null,
          "max_wall_clock_ms": null,
          "max_retries": null
        },
        // review: prompt | bounded (max_rounds 1..8, rounds remaining must
        // absorb rework before the terminal circuit breaker opens)
        "review": { "mode": "prompt", "max_rounds": 2 },
        // clarify: auto | off (auto = the orchestrator uses the native ask
        // tool for targeted clarifying questions before decomposing an
        // ambiguous task; off = previous behavior)
        "clarify": { "mode": "auto" }
      }
    }
  ],
  // Native OpenCode subagent nesting depth: defaults to 1, which would stop
  // the approved deepest chain (orchestrator -> implementer -> planner ->
  // explore) after the first hop. The installer adds this top-level key only
  // when it is absent; an explicit value you set is always preserved.
  "experimental": {
    "subagent_depth": 3
  },
  // The `permissions` blocks below mirror the installer's fresh-install
  // defaults (src/cli/install.ts): a broad `subagent` deny followed by exact
  // target-specific allows for the bounded nested-delegation graph
  // (orchestrator→all roles; implementer→planner+explore; planner→explore;
  // reviewer→explore; explore→no delegation). The agent transform never
  // overrides user-authored permission rules; agents preserved from an older
  // install must be migrated by hand (see README).
  "agents": {
    "orchestrator": {
      "mode": "primary",
      "model": "opencode/big-pickle",
      "permissions": [
        { "action": "*", "resource": "*", "effect": "deny" },
        { "action": "orchestrator_goal", "resource": "*", "effect": "allow" },
        { "action": "orchestrator_gh", "resource": "*", "effect": "allow" },
        { "action": "orchestrator_worktree", "resource": "*", "effect": "allow" },
        { "action": "orchestrator_validation", "resource": "*", "effect": "allow" },
        { "action": "orchestrator_observability", "resource": "*", "effect": "allow" },
        { "action": "read", "resource": "*", "effect": "allow" },
        { "action": "glob", "resource": "*", "effect": "allow" },
        { "action": "grep", "resource": "*", "effect": "allow" },
        { "action": "webfetch", "resource": "*", "effect": "allow" },
        { "action": "websearch", "resource": "*", "effect": "allow" },
        { "action": "shell", "resource": "*", "effect": "ask" },
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "planner", "effect": "allow" },
        { "action": "subagent", "resource": "explore", "effect": "allow" },
        { "action": "subagent", "resource": "implementer", "effect": "allow" },
        { "action": "subagent", "resource": "reviewer", "effect": "allow" },
        { "action": "read", "resource": "*.env", "effect": "ask" },
        { "action": "read", "resource": "*.env.*", "effect": "ask" },
        { "action": "read", "resource": "*.env.example", "effect": "allow" }
      ]
    },
    "planner": {
      "mode": "subagent",
      "model": "opencode/big-pickle",
      "permissions": [
        { "action": "*", "resource": "*", "effect": "deny" },
        { "action": "orchestrator_goal", "resource": "*", "effect": "deny" },
        { "action": "orchestrator_gh", "resource": "*", "effect": "deny" },
        { "action": "orchestrator_worktree", "resource": "*", "effect": "deny" },
        { "action": "orchestrator_validation", "resource": "*", "effect": "deny" },
        { "action": "orchestrator_observability", "resource": "*", "effect": "deny" },
        { "action": "read", "resource": "*", "effect": "allow" },
        { "action": "glob", "resource": "*", "effect": "allow" },
        { "action": "grep", "resource": "*", "effect": "allow" },
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "explore", "effect": "allow" },
        { "action": "shell", "resource": "*", "effect": "ask" },
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "read", "resource": "*.env", "effect": "ask" },
        { "action": "read", "resource": "*.env.*", "effect": "ask" },
        { "action": "read", "resource": "*.env.example", "effect": "allow" }
      ]
    },
    "explore": {
      "mode": "subagent",
      "model": "opencode/big-pickle",
      "permissions": [
        { "action": "*", "resource": "*", "effect": "deny" },
        { "action": "orchestrator_goal", "resource": "*", "effect": "deny" },
        { "action": "orchestrator_gh", "resource": "*", "effect": "deny" },
        { "action": "orchestrator_worktree", "resource": "*", "effect": "deny" },
        { "action": "orchestrator_validation", "resource": "*", "effect": "deny" },
        { "action": "orchestrator_observability", "resource": "*", "effect": "deny" },
        { "action": "read", "resource": "*", "effect": "allow" },
        { "action": "glob", "resource": "*", "effect": "allow" },
        { "action": "grep", "resource": "*", "effect": "allow" },
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "webfetch", "resource": "*", "effect": "allow" },
        { "action": "websearch", "resource": "*", "effect": "allow" },
        { "action": "read", "resource": "*.env", "effect": "ask" },
        { "action": "read", "resource": "*.env.*", "effect": "ask" },
        { "action": "read", "resource": "*.env.example", "effect": "allow" }
      ]
    },
    "implementer": {
      "mode": "subagent",
      "model": "opencode/big-pickle",
      "permissions": [
        { "action": "*", "resource": "*", "effect": "deny" },
        { "action": "orchestrator_goal", "resource": "*", "effect": "deny" },
        { "action": "orchestrator_gh", "resource": "*", "effect": "deny" },
        { "action": "orchestrator_worktree", "resource": "*", "effect": "deny" },
        { "action": "orchestrator_validation", "resource": "*", "effect": "deny" },
        { "action": "orchestrator_observability", "resource": "*", "effect": "deny" },
        { "action": "read", "resource": "*", "effect": "allow" },
        { "action": "glob", "resource": "*", "effect": "allow" },
        { "action": "grep", "resource": "*", "effect": "allow" },
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "planner", "effect": "allow" },
        { "action": "subagent", "resource": "explore", "effect": "allow" },
        { "action": "edit", "resource": "*", "effect": "allow" },
        { "action": "shell", "resource": "*", "effect": "ask" },
        { "action": "webfetch", "resource": "*", "effect": "allow" },
        { "action": "websearch", "resource": "*", "effect": "allow" },
        { "action": "read", "resource": "*.env", "effect": "ask" },
        { "action": "read", "resource": "*.env.*", "effect": "ask" },
        { "action": "read", "resource": "*.env.example", "effect": "allow" }
      ]
    },
    "reviewer": {
      "mode": "subagent",
      "model": "opencode/big-pickle",
      "permissions": [
        { "action": "*", "resource": "*", "effect": "deny" },
        { "action": "orchestrator_goal", "resource": "*", "effect": "deny" },
        { "action": "orchestrator_gh", "resource": "*", "effect": "deny" },
        { "action": "orchestrator_worktree", "resource": "*", "effect": "deny" },
        { "action": "orchestrator_validation", "resource": "*", "effect": "deny" },
        { "action": "orchestrator_observability", "resource": "*", "effect": "deny" },
        { "action": "read", "resource": "*", "effect": "allow" },
        { "action": "glob", "resource": "*", "effect": "allow" },
        { "action": "grep", "resource": "*", "effect": "allow" },
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "explore", "effect": "allow" },
        { "action": "shell", "resource": "*", "effect": "ask" },
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "read", "resource": "*.env", "effect": "ask" },
        { "action": "read", "resource": "*.env.*", "effect": "ask" },
        { "action": "read", "resource": "*.env.example", "effect": "allow" }
      ]
    }
  }
}
