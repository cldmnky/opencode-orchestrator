Output docs/assets/orchestrate-demo.gif
Set Width 1200
Set Height 700
Set FontSize 14
Set Theme "Catppuccin Mocha"
Set Padding 10
Set BorderRadius 8
Set WindowBar Colorful

# Open with your project that has the plugin installed
Type "opencode2" Enter
Sleep 2s

# Run the main command — be specific about the outcome
Type "/orchestrate add input validation to the user form and cover it with tests" Enter

# Let it run: explore + plan (parallel), implement, review
Sleep 25s

# Optional: show the result summary
Sleep 2s
