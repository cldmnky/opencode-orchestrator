{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    {
      "package": "./src/index.ts",
      "options": {
        "orchestrator": "orchestrator",
        "roles": {
          "planning": "planner",
          "research": "explore",
          "implementation": "implementer",
          "review": "reviewer"
        },
        "max_parallel": 4,
        "require_review": true,
        "strict_agents": true,
        "commands": {},
        "goal": {
          "auto_continue": true,
          "max_continuations": 50,
          "cooldown_ms": 1000
        },
        "github": {
          "enabled": true,
          "allow_mutations": false
        },
        "worktree": {
          "enabled": true,
          "allow_mutations": true,
          "root": "/private/tmp/opencode-orchestrator-worktrees"
        },
        // S3/V1 controls enabled for live verification of the plugin surface.
        // trace snapshot: bounded metadata-only summaries persisted per session.
        "trace": {
          "mode": "snapshot"
        },
        // stop-between-steps with conservative step/retry limits only: no
        // token/cost/wall-clock limits, so nothing fails closed before live
        // usage snapshots are observed.
        "budget": {
          "mode": "stop-between-steps",
          "max_steps": 1000,
          "max_retries": 100
        },
        // Bounded maker-checker review with the default round ceiling.
        "review": {
          "mode": "bounded",
          "max_rounds": 2
        }
      }
    }
  ],
  "permissions": [
    {
      "action": "external_directory",
      "resource": "/private/tmp/opencode-orchestrator-worktrees/*",
      "effect": "allow"
    }
  ],
  "agents": {
    "orchestrator": {
      "mode": "primary",
      "model": "openai/gpt-5.6-sol#xhigh"
    },
    "planner": {
      "mode": "subagent",
      "model": "openai/gpt-5.6-luna#max"
    },
    "explore": {
      "mode": "subagent",
      "model": "opencode-go/mimo-v2.5"
    },
    "implementer": {
      "mode": "subagent",
      "model": "opencode-go/deepseek-v4-flash#high"
    },
    "reviewer": {
      "mode": "subagent",
      "model": "opencode-go/muse-spark-1.2-contributor#xhigh"
    }
  }
}
