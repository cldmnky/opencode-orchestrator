{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    {
      "package": "./src/index.ts",
      "options": {
        "orchestrator": "orchestrator",
        "roles": {
          "planning": "planner",
          "research": "explore",
          "implementation": "implementer",
          "review": "reviewer"
        },
        "max_parallel": 4,
        "require_review": true,
        "strict_agents": true,
        "commands": {},
        "goal": {
          "auto_continue": true,
          "max_continuations": 50,
          "cooldown_ms": 1000
        },
        "github": {
          "enabled": true,
          "allow_mutations": false
        },
        "worktree": {
          "enabled": true,
          "allow_mutations": true,
          "root": "/Users/mbengtss/code/src/github.com/cldmnky/opencode-orchestrator-worktrees"
        }
      }
    }
  ],
  "agents": {
    "orchestrator": {
      "mode": "primary",
      "model": "openai/gpt-5.6-sol#xhigh"
    },
    "planner": {
      "mode": "subagent",
      "model": "openai/gpt-5.6-luna#max"
    },
    "explore": {
      "mode": "subagent",
      "model": "opencode-go/mimo-v2.5"
    },
    "implementer": {
      "mode": "subagent",
      "model": "opencode-go/deepseek-v4-flash#high"
    },
    "reviewer": {
      "mode": "subagent",
      "model": "opencode-go/muse-spark-1.2-contributor#xhigh"
    }
  }
}
