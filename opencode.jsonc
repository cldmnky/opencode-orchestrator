{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    {
      "package": "./src/index.ts",
      "options": {
        "orchestrator": "orchestrator",
        "roles": {
          "planning": "planner",
          "research": "explore",
          "implementation": "implementer",
          "review": "reviewer"
        },
        "max_parallel": 4,
        "strict_agents": true
      }
    }
  ],
  "agents": {
    "orchestrator": {
      "mode": "primary",
      "model": "openai/gpt-5.6-sol#xhigh"
    },
    "planner": {
      "mode": "subagent",
      "model": "openai/gpt-5.6-luna#max"
    },
    "explore": {
      "mode": "subagent",
      "model": "opencode-go/mimo-v2.5"
    },
    "implementer": {
      "mode": "subagent",
      "model": "opencode-go/deepseek-v4-flash#high"
    },
    "reviewer": {
      "mode": "subagent",
      "model": "opencode-go/grok-4.6#high"
    }
  }
}
